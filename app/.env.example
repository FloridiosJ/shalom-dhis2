# Backend GraphQL Endpoint
# Configure this to point to your backend server
EXPO_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4000/graphql

# For production, use:
# EXPO_PUBLIC_GRAPHQL_ENDPOINT=https://your-production-server.com/graphql

# For local network testing (replace with your computer's IP):
# EXPO_PUBLIC_GRAPHQL_ENDPOINT=http://192.168.1.100:4000/graphql

# Note: 
# - Use EXPO_PUBLIC_ prefix for variables accessible in the app
# - Never commit sensitive data in this file
# - Copy this file to .env and configure for your environment

# Legacy API Configuration (if needed)
API_URL=https://your-api-url.com
API_KEY=your-api-key-here

